---
import Legal from "../../layouts/Legal.astro";
import { SITE } from "../../site";
const lang = "tr" as const;
---
<Legal lang={lang} page="contact" title="İletişim ve destek" eyebrow="İletişim" dated={false}
  description="Destek, gizlilik soruları ve hesap silme için GlotKids iletişim bilgileri.">
  <p>Destek, öneri, gizlilik soruları ve hesap silme için <a href={`mailto:${SITE.email}`}>{SITE.email}</a> adresine yazın.</p>
  <p>Lütfen çocuğunuzun adını, fotoğrafını ya da başka kişisel bilgisini göndermeyin; yardım etmemiz için gerekmez. Bir sorun için cihaz modeli, uygulama sürümü ve oyunun adı yeter.</p>
</Legal>
