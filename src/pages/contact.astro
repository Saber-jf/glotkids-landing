---
import Legal from "../layouts/Legal.astro";
import { SITE } from "../site";
const lang = "en" as const;
---
<Legal lang={lang} page="contact" title="Contact and support" eyebrow="Contact" dated={false}
  description="How to reach GlotKids for support, privacy questions and account deletion.">
  <p>For support, ideas, privacy questions and account deletion, write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
  <p>Please don't send your child's name, photo or other personal details; we don't need them to help. For a problem, the device model, the app version and the game are enough.</p>
</Legal>
