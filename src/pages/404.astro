---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="The page you are looking for is not here." lang="en" page="404">
  <section class="page-head" style="text-align:center;padding:90px 0 120px">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>Lili couldn't find this page</h1>
      <p class="lead" style="margin:0 auto 24px">Perhaps the address was mistyped, or the page has moved. · Lili bu sayfayı bulamadı.</p>
      <a class="btn coral" href="/">Home</a> <a class="btn white" href="/tr/">Türkçe</a>
    </div>
  </section>
</Base>
