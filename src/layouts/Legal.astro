---
import Base from "./Base.astro";
import { SITE } from "../site";
import { UI, fmtDate, type Lang, type Page } from "../i18n";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  page: Page;
  /** the table of contents: [anchor id, heading] */
  toc?: [string, string][];
  eyebrow: string;
  intro?: string;
  dated?: boolean;
}
const { title, description, lang, page, toc = [], eyebrow, intro, dated = true } = Astro.props;
const t = UI[lang];
---
<Base title={title} description={description} lang={lang} page={page}>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      {intro && <p class="lead">{intro}</p>}
      {dated && <p class="meta">{t.updated}: {fmtDate(SITE.legalUpdated, lang)}</p>}
    </div>
  </section>
  <div class="wrap">
    <div class="doc" style={toc.length ? "" : "grid-template-columns:minmax(0,1fr)"}>
      {toc.length > 0 && (
        <nav class="toc" aria-label={t.onPage}>
          <b>{t.onPage}</b>
          <ol>{toc.map(([id, h]) => <li><a href={`#${id}`}>{h}</a></li>)}</ol>
        </nav>
      )}
      <article class="prose">
        <slot />
      </article>
    </div>
  </div>
</Base>
