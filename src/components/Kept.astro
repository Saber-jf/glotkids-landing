---
/* One retention period (src/site.ts → DECISIONS.retention), or its blank. */
import { DECISIONS } from "../site";
import type { Lang } from "../i18n";
import Todo from "./Todo.astro";
interface Props { k: keyof typeof DECISIONS.retention; lang: Lang }
const { k, lang } = Astro.props;
const v = DECISIONS.retention[k];
---
{v ? v[lang] : <Todo lang={lang}>{lang === "en" ? "retention period" : "saklama süresi"}</Todo>}
