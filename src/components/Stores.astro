---
/* The two stores, before launch: dark store-style badges that say "soon".
   Generic glyphs, not the stores' own logos or badge artwork: those may only
   be used, as supplied, once the app is in the store (then swap in the
   official badges and their links here, in one place). */
import type { Lang } from "../i18n";
interface Props { big?: boolean; align?: "center" | "start"; lang: Lang }
const { big = false, align = "center", lang } = Astro.props;
const T = lang === "en"
  ? { soon: "Coming soon", ios: "Coming soon to the App Store, for iPhone and iPad", android: "Coming soon to Google Play, for Android phones and tablets" }
  : { soon: "Çok yakında", ios: "Çok yakında App Store'da, iPhone ve iPad için", android: "Çok yakında Google Play'de, Android telefon ve tabletler için" };
---
<div class:list={["stores-row", { big }]} style={`justify-content:${align === "center" ? "center" : "flex-start"}`}>
  <span class="store" role="img" aria-label={T.ios}>
    <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="8" y="3" width="16" height="26" rx="4" fill="none" stroke="currentColor" stroke-width="2.4"/><circle cx="16" cy="24.5" r="1.6" fill="currentColor"/><path d="M13 7h6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    <span class="txt"><small>{T.soon}</small><b>App Store</b></span>
    <span class="soon">iPhone · iPad</span>
  </span>
  <span class="store" role="img" aria-label={T.android}>
    <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M8 4.5v23l20-11.5z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="M8 4.5l12 12.5M8 27.5l12-11" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    <span class="txt"><small>{T.soon}</small><b>Google Play</b></span>
    <span class="soon">Android</span>
  </span>
</div>

<style>
  .stores-row { display: flex; flex-wrap: wrap; gap: 14px; }
  .store {
    position: relative; display: inline-flex; align-items: center; gap: 12px;
    min-width: 214px; padding: 10px 22px 8px 16px; border-radius: 18px;
    background: #1d2b33; color: #fff; border-bottom: 6px solid #0b1216;
    transform: rotate(-1deg);
  }
  .store + .store { transform: rotate(1deg); }
  .store svg { width: 34px; height: 34px; flex: 0 0 34px; color: var(--sun); }
  .store + .store svg { color: var(--leaf); }
  .txt { display: flex; flex-direction: column; line-height: 1.05; text-align: left; }
  .txt small { font-family: var(--body); font-weight: 600; font-size: 0.78rem; opacity: 0.8; letter-spacing: 0.02em; }
  .txt b { font-family: var(--display); font-weight: 600; font-size: 1.45rem; }
  .soon {
    position: absolute; top: -12px; right: -8px; font-family: var(--display); font-weight: 600; font-size: 0.78rem;
    background: var(--coral); color: #fff; border-radius: 999px; padding: 3px 10px 2px; border-bottom: 3px solid var(--coral-lip);
    transform: rotate(4deg); white-space: nowrap;
  }
  .big .store { min-width: 250px; padding: 14px 26px 12px 20px; }
  .big .store svg { width: 40px; height: 40px; flex-basis: 40px; }
  .big .txt b { font-size: 1.7rem; }
</style>
