---
/* The providers table (src/site.ts → PROVIDERS), in either language. */
import { PROVIDERS } from "../site";
import type { Lang } from "../i18n";
import Todo from "./Todo.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const H = lang === "en"
  ? { who: "Provider", what: "What for", data: "What data", where: "Where", role: "Role", processor: "Processes data on our behalf", independent: "Also acts on its own behalf (its own privacy policy applies)", region: "data region", roleT: "role, per the contract", name: "provider", unv: "not yet verified" }
  : { who: "Sağlayıcı", what: "Ne için", data: "Hangi veri", where: "Nerede", role: "Rolü", processor: "Bizim adımıza işler", independent: "Kendi adına da işler (kendi politikası geçerli)", region: "veri bölgesi", roleT: "sözleşmeye göre rol", name: "sağlayıcı", unv: "doğrulanmadı" };
---
<div class="table-scroll"><table>
  <thead><tr><th>{H.who}</th><th>{H.what}</th><th>{H.data}</th><th>{H.where}</th><th>{H.role}</th></tr></thead>
  <tbody>
    {PROVIDERS.map((p) => (
      <tr>
        <td>{p.name ?? <Todo lang={lang}>{H.name}</Todo>}</td>
        <td>{p.what[lang]}</td>
        <td>{p.data[lang]}</td>
        <td>{p.region ? p.region[lang] : <Todo lang={lang}>{H.region}</Todo>}</td>
        <td>{p.role ? H[p.role] : <Todo lang={lang}>{H.roleT}</Todo>}{!p.verified && <> <Todo lang={lang}>{H.unv}</Todo></>}</td>
      </tr>
    ))}
  </tbody>
</table></div>
