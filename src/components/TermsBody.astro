---
/*
 * Terms & Conditions, in either language: one source, so the two can't drift.
 * The shape is the company's other app's (glotcast.com/terms; user, 2026-11-20):
 * fifteen plain numbered sections for a global app. What differs is what
 * GlotKids is: an app for children, used with a parent, with an optional
 * parent account.
 */
import Legal from "../layouts/Legal.astro";
import { SITE } from "../site";
import { href, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === "en";
const mail = SITE.email;
---
<Legal lang={lang} page="terms"
  title={en ? "Terms & Conditions" : "Kullanım Koşulları"} eyebrow={en ? "Legal" : "Yasal"}
  description={en ? "The terms of use of the GlotKids app and website." : "GlotKids uygulamasının ve web sitesinin kullanım koşulları."}
  intro={en
    ? "These Terms are for parents and legal guardians. Your child uses GlotKids with your permission and under your supervision."
    : "Bu koşullar ebeveynler ve yasal temsilciler içindir. Çocuğunuz GlotKids'i sizin izninizle ve gözetiminizde kullanır."}>

  <h2>{en ? "1. Acceptance of these Terms" : "1. Koşulların kabulü"}</h2>
  {en
    ? <p>By downloading the app, creating an account or using any part of the Service, you agree to these Terms. If you do not agree, do not use the Service. The "Service" means the GlotKids mobile app, this website and related services.</p>
