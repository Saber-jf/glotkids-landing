{
  "name": "glotkids-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host",
    "build": "node scripts/check.mjs pre && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check.mjs post",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host",
    "assets": "bash scripts/assets.sh"
  },
  "dependencies": {
    "astro": "7.4.12",
    "lottie-web": "5.13.0"
  }
}
